{
  "name": "biiif",
  "version": "1.0.7",
  "description": "A CLI to build IIIF collections",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edsilv/biiif.git"
  },
  "scripts": {
    "build": "npm run format && tsc",
    "format": "prettier --write \"**/*.*\"",
    "precommit": "npm run build",
    "pretest": "npm run build",
    "test": "mocha",
    "testbuild": "node --nolazy --inspect-brk=5858 -e \"require('./index').build('test/collection', 'https://sitename.netlify.app')\"",
    "serve": "serve test"
  },
  "engines": {
    "node": ">=8.9.1",
    "npm": ">=3.10.8"
  },
  "keywords": [
    "IIIF",
    "nodejs",
    "CLI"
  ],
  "author": "@edsilv",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/edsilv/biiif/issues"
  },
  "homepage": "https://github.com/edsilv/biiif#readme",
  "dependencies": {
    "@iiif/vocabulary": "^1.0.20",
    "chalk": "^4.1.2",
    "ffprobe": "^1.1.2",
    "ffprobe-static": "^3.0.0",
    "glob": "^7.1.6",
    "glob-promise": "^4.0.1",
    "is-url": "^1.2.4",
    "js-yaml": "^4.0.0",
    "jsonfile": "^6.1.0",
    "node-addon-api": "^8.0.0",
    "node-gyp": "^10.1.0",
    "sharp": "^0.33.5",
    "url-join": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "mocha": "^11.7.5",
    "mock-fs": "^5.5.0",
    "prettier": "^2.8.8",
    "serve": "^14.2.6",
    "typescript": "^5.9.3"
  }
}
